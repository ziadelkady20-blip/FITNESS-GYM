{
  "buildCommand": "node scripts/inject-cms.mjs",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*\\.(jpg|jpeg|png|webp|JPG|JPEG|PNG|WEBP))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
